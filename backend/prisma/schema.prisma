// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id                  String     @id       @default(uuid())
  username            String     @unique
  password            String
  gender              Gender
  channelName         String
  banner              String?
  profilePicture      String?
  subscriberCount     Int       @default(0)
  description         String?
  uploads             Uploads[]
  history             History[]
  subscriptions       Subscriptions[] @relation("Subscriber")
  subscribers         Subscriptions[] @relation("Channel")
}


model Uploads{
  id                  String    @id       @default(uuid())
  title               String    @default("")
  videoUrl            String
  thumbnail           String
  userid              String
  user                User      @relation(fields: [userid], references: [id])
  createdAt           DateTime  @default(now())
  history             History[]
}


model History{
  id                  String    @id       @default(uuid())
  userId              String
  uploadedId          String
  watchedAt           DateTime  @default(now())

  user                User      @relation(fields: [userId], references: [id])
  uploads             Uploads   @relation(fields: [uploadedId], references: [id])
}

model Subscriptions {
  id            String   @id @default(uuid())
  subscriberId  String
  channelId     String

  subscriber    User     @relation("Subscriber", fields: [subscriberId], references: [id])
  channel       User     @relation("Channel", fields: [channelId], references: [id])

  createdAt     DateTime @default(now())
}




enum Gender{
  Male
  Female
  Other
  
  }
